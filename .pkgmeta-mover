package-as: DandersMover
enable-nolib-creation: no

# Used by .github/workflows/release-mover.yml (`-m .pkgmeta-mover`) on
# `mover-v*` tags: ships ONLY the DandersMover folder to its own CurseForge
# project. Same move-folders shape as .pkgmeta; everything else in the
# container is ignored.
move-folders:
  DandersMover/DandersMover: DandersMover

ignore:
  - DandersFrames
  - DandersFrames_Options
  - DandersFrames_UnitFrames
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - RELEASE_NOTES_MOVER.md
  - CHANGELOG_ARCHIVE.md
  - README.md
  - TRANSLATING.md
  - generate_changelog.sh
  - Tools
  - .github
  - .gitignore
  - .gitnexus
  - .pkgmeta
  - docs
  # Canonical source of the shared UI library -- shipped only as the embedded
  # copy at DandersMover/Libs/DandersUI (Tools/sync-libs.sh).
  - DandersUI
  # dev-only test consumer, never shipped
  - DandersMoverDemo
  # The guides, for the repo. README and LICENSE do ship.
  - DandersMover/docs

manual-changelog:
  # Written by release-mover.yml: the top section of DandersMover/CHANGELOG.md.
  filename: RELEASE_NOTES_MOVER.md
  markup-type: markdown

embedded-libraries:
  - libstub
  - callbackhandler
