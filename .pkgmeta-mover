package-as: DandersMover
enable-nolib-creation: no

# Second packager run (release.yml, `-m .pkgmeta-mover`): ships ONLY the
# DandersMover folder to its own CurseForge project. Same move-folders shape
# as .pkgmeta; everything else in the container is ignored.
move-folders:
  DandersMover/DandersMover: DandersMover

ignore:
  - DandersFrames
  - DandersFrames_Options
  - CHANGELOG.md
  - CHANGELOG_ARCHIVE.md
  - README.md
  - TRANSLATING.md
  - generate_changelog.sh
  - Tools
  - .github
  - .gitignore
  - .gitnexus
  - .pkgmeta
  - docs
  # Canonical source of the shared UI library -- shipped only as the embedded
  # copy at DandersMover/Libs/DandersUI (Tools/sync-libs.sh).
  - DandersUI
  # dev-only test consumer, never shipped
  - DandersMoverDemo

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

embedded-libraries:
  - libstub
  - callbackhandler
optional-dependencies:
  - danders-frames
